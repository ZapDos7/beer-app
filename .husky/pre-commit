#!/usr/bin/env sh

# 1. Identify all STAGED Java files
# --cached looks at the index (staged files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d -- '*.java')

if [ -z "$STAGED_FILES" ]; then
    echo "No Java files staged. Skipping Spotless."
    exit 0
fi

echo "🔎 Running Spotless formatting on staged Java files..."

# 2. Run spotless:apply on the entire project from the project root
mvn spotless:apply || { echo "❌ mvnw failed"; exit 1; }

# 3. Re-stage the files that were modified by Spotless
for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then         # Add the file to the index again so the formatted version is committed
      git add "$FILE"
      echo "✅ Re-staged formatted file: $FILE"
    fi
done

echo "🎉 Formatting complete. Commit proceeding." exit 0